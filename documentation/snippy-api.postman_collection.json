          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 503', () => pm.expect([201, 400, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has url + asset', () => {",
                  "    pm.expect(json.url).to.be.a('string');",
                  "    pm.expect(json.asset).to.be.an('object');",
                  "  });",
                  "  if (json.asset && json.asset.assetId) {",
                  "    pm.collectionVariables.set('assetId', json.asset.assetId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Attach a PNG/JPEG/GIF/WebP/SVG ≤ 5MB in Postman before sending."
                },
                {
                  "key": "subFolder",
                  "type": "text",
                  "value": "general"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/resources",
            "description": "multipart/form-data. You must select a file for `file` in the Postman UI."
          }
        },
        {
          "name": "DELETE Asset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204, 404, or 503', () => pm.expect([204, 404, 503]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/resources/{{assetId}}",
            "description": "Requires `assetId` from a successful upload."
          }
        }
