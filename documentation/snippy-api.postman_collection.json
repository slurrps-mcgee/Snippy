            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Hello Pen\",\n  \"description\": \"Created via Postman collection\",\n  \"tags\": [\"postman\", \"demo\"],\n  \"isPrivate\": false,\n  \"snippetFiles\": [\n    {\n      \"fileType\": \"html\",\n      \"content\": \"<h1>Hello from Postman</h1>\\n<p class=\\\"tagline\\\">Snippy API test</p>\"\n    },\n    {\n      \"fileType\": \"css\",\n      \"content\": \"h1 { color: #2563eb; font-family: sans-serif; }\\n.tagline { opacity: 0.8; }\"\n    },\n    {\n      \"fileType\": \"js\",\n      \"content\": \"console.log('Postman pen loaded');\"\n    }\n  ],\n  \"externalResources\": [\n    {\n      \"resourceType\": \"css\",\n      \"url\": \"https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.css\"\n    }\n  ]\n}"
