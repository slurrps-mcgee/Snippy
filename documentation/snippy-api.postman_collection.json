{
  "info": {
    "_postman_id": "a1b2c3d4-snippy-api-collection",
    "name": "Snippy API",
    "description": "Full Snippy backend collection (`/api/v1` + `/health`).\n\n**Setup:**\n1. Set collection variable `accessToken` to a valid Auth0 access token.\n2. Run folders in order: Health → Users → Snippets → Comments → Favorites → Follows → Collections → Resources.\n3. Embed is public (no JWT). Destructive requests are last.\n\n**Resources** require MinIO (`ENABLE_MINIO=true`); otherwise expect 503.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "userName", "value": "testuser" },
    { "key": "shortId", "value": "" },
    { "key": "snippetId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "assetId", "value": "" },
    { "key": "forkSnippetId", "value": "" },
    { "key": "forkShortId", "value": "" },
    { "key": "followUserName", "value": "" },
    { "key": "collectionId", "value": "" },
    { "key": "collectionShortId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has status ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('Has minio flag', () => pm.expect(json).to.have.property('minio'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public liveness probe — no JWT required."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "POST Ensure User",
          "event": [
            {
              "listen": "test",
              "script": {
